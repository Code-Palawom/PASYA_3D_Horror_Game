  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  steps:
  - id: dialog
    highlightTarget: {fileID: 802719604}
    instructionText: <b>In This Game</b>\n\nEvery single step triggers a question.\nIn
      this continuous, choice-driven quiz experience, the environment itself is built
      out of trivia.\nEvery button you press, door you unlock, or item you collect
      forces you to face a new inquiry.\nProgress is not measured by reflexes, but
      by knowledge and quick thinking.\n\n<i>(click anywhere to proceed)</i>
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 5
    autoStart: 1
  - id: move
    highlightTarget: {fileID: 1163991172}
    instructionText: Drag to move
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 3
    autoStart: 1
  - id: jump
    highlightTarget: {fileID: 1039867670}
    instructionText: Click to jump
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 3
    autoStart: 1
  - id: crouch
    highlightTarget: {fileID: 1172548748}
    instructionText: Hold to crouch
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 3
    autoStart: 1
  - id: run
    highlightTarget: {fileID: 1064105269}
    instructionText: Click to run
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 3
    autoStart: 1
  - id: backpack
    highlightTarget: {fileID: 1339434561}
    instructionText: Click to open backpack/inventory
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 4
    autoStart: 1
  - id: chat
    highlightTarget: {fileID: 1963458066}
    instructionText: You can see system logs\nand chats here
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 9
    autoStart: 1
  - id: inventoryhotbar
    highlightTarget: {fileID: 553321322}
    instructionText: Here you can see your inventory hotbar
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 2
    autoStart: 1
  - id: task
    highlightTarget: {fileID: 761983978}
    instructionText: Here you can see current task\nclick a task to show hint (some
      task only)
    completionType: 2
    targetButton: {fileID: 0}
    pulseCount: 3
    dialogPosition: 9
    autoStart: 1
  - id: moveitem
    highlightTarget: {fileID: 553321322}
    instructionText: Drag item to move it between slots\nDrag outside the slots to
